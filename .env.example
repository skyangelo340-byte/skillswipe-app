# GEMINI_API_KEY: Required for Gemini AI API calls (unused by SkillSwipe MVP).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional TURN relay configuration for reliable WebRTC video calls across CGNAT/restrictive firewalls.
# Never hardcode credentials in source code; use time-limited TURN credentials in production.
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
